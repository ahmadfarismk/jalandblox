# Copy this file to .env and fill in values. Never commit .env.

# true  = use fake data from src/core/mocks (no backend needed)
# false = use the real versions in src/core/real
VITE_USE_MOCKS=true

# Supabase (task F8). See supabase/README.md.
# Only the PUBLIC key goes here: the "publishable" key (sb_publishable_...) or
# the old "anon" key. It ships inside the app, so it is public on purpose.
# NEVER put the secret key (sb_secret_... or "service_role") here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
