# Copy this file to .env and fill in values. Never commit .env.

# Which parts use fake versions (src/core/mocks) instead of real ones:
#   true  = all fakes: check-in always gives gold, even at your desk
#   false = everything real
#   api   = only these parts fake (list: location, checkin, api)
# The live site uses .env.production instead of this file.
VITE_USE_MOCKS=true

# Supabase (task F8). See supabase/README.md.
# Only the PUBLIC key goes here: the "publishable" key (sb_publishable_...) or
# the old "anon" key. It ships inside the app, so it is public on purpose.
# NEVER put the secret key (sb_secret_... or "service_role") here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
